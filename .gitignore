# ==============================================================================
# 1. AI, LLM & ENVIRONMENTAL SECRETS (CRITICAL)
# ==============================================================================
# Never commit API keys or runtime configurations
.env
.env.*
!.env.example
secrets.json
config.yaml
!config.example.yaml

# ==============================================================================
# 2. GO BINARIES & ARTIFACTS
# ==============================================================================
# Compiled binaries and execution files
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
out/
dist/

# Test artifacts and coverage files
*.test
*.out
coverage.txt
profile.out

# ==============================================================================
# 3. AGENT RUNTIME, LOGS & CACHE
# ==============================================================================
# Agent logs, trace data, and state snapshots
*.log
logs/
agent_outputs/
runs/
.cache/
telemetry.json

# Local agent database states and runtime key-value dumps
*.db
*.sqlite
*.bbolt
*.badger

# ==============================================================================
# 4. VECTOR DATABASES & LOCAL DATA
# ==============================================================================
# Prevent local data directories from bloating the repo
chroma/
.chroma/
.data/chroma/
faiss_index/
qdrant/
data/raw/
data/processed/
*.csv
*.jsonl
*.parquet

# ==============================================================================
# 5. CODE EDITORS & DEVELOPMENT TOOLS
# ==============================================================================
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# AI Assistant workspaces
.cursorignore
.claudeignore
