# Enterprise Multi-Agent AI Assistant Environment Template

# Core Application Settings
APP_NAME="Enterprise Multi-Agent AI Assistant"
MODEL_NAME="llama-3.3-70b-versatile"
APP_DEBUG=False

# LLM & External Tool Credentials
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Database Configurations
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/enterprise_db
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=generate_a_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
MAX_UPLOAD_SIZE_MB=10
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# LangSmith Tracing & Observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=enterprise-ai-assistant

# AWS Storage Configuration (Optional)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_enterprise_s3_bucket_name
